#!/bin/bash
# rehtet - share your Mac's Wi-Fi with an iPhone over a USB-C cable.
# https://github.com/xatuke/rehtet
#
# How it works: the iPhone's Personal Hotspot over USB gives the Mac and the
# phone an IP link. A small HTTP proxy on the Mac listens on that link, and a
# cellular APN configuration profile on the phone points at the proxy. Every
# HTTP/HTTPS request from the phone then travels down the cable and out the
# Mac's Wi-Fi. Cellular data stays on only as the carrier of that setting.

set -u
VERSION="0.1.0"
CFG_DIR="$HOME/.rehtet"
CFG="$CFG_DIR/config"
PROXY_CONF="$CFG_DIR/tinyproxy.conf"
PROXY_LOG="$CFG_DIR/proxy.log"
PROXY_PID="$CFG_DIR/proxy.pid"
PROFILE="$CFG_DIR/rehtet.mobileconfig"
SERVE_PID="$CFG_DIR/serve.pid"
HITS="$CFG_DIR/profile-hits.log"
PROXY_PORT=8888
PROFILE_PORT=8080

# ---------- ui ----------
if [ -t 1 ]; then
  B=$(tput bold); D=$(tput dim); G=$(tput setaf 2); Y=$(tput setaf 3); R=$(tput setaf 1); C=$(tput setaf 6); N=$(tput sgr0)
else
  B=""; D=""; G=""; Y=""; R=""; C=""; N=""
fi
say()  { printf '%s\n' "$*"; }
ok()   { printf '%s✔%s %s\n' "$G" "$N" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$N" "$*"; }
fail() { printf '%s✘%s %s\n' "$R" "$N" "$*"; }
hint() { printf '  %s→ %s%s\n' "$C" "$*" "$N"; }
step() { printf '\n%s%s%s\n' "$B" "$*" "$N"; }
pause(){ printf '%s' "${D}Press Enter when done.${N} "; read -r _; }
ask()  { local a; printf '%s ' "$1" >&2; read -r a; printf '%s' "$a"; }
yesno(){ local a; while true; do printf '%s [y/n] ' "$1"; read -r a; case "$a" in y|Y) return 0;; n|N) return 1;; esac; done; }
dot()  { printf '.'; }

cleanup() { stop_serve; }
trap cleanup EXIT

# ---------- config ----------
load_cfg() { [ -f "$CFG" ] && . "$CFG"; APN="${APN:-}"; LINK_ADDR="${LINK_ADDR:-}"; PHONE_IP="${PHONE_IP:-}"; }
save_cfg() {
  mkdir -p "$CFG_DIR"; chmod 700 "$CFG_DIR"
  printf 'APN=%q\nLINK_ADDR=%q\nPHONE_IP=%q\n' "$APN" "$LINK_ADDR" "$PHONE_IP" > "$CFG"
}

# ---------- detection ----------
usb_iface()   { networksetup -listallhardwareports 2>/dev/null | awk '/^Hardware Port: iPhone USB$/{getline; print $2; exit}'; }
wifi_iface()  { networksetup -listallhardwareports 2>/dev/null | awk '/^Hardware Port: Wi-Fi$/{getline; print $2; exit}'; }
phone_on_usb(){ ioreg -p IOUSB 2>/dev/null | grep -q iPhone; }
iface_exists(){ [ -n "${1:-}" ] && ifconfig "$1" >/dev/null 2>&1; }
link_addr()   { local a; a=$(ipconfig getifaddr "$1" 2>/dev/null); case "$a" in 169.254.*|"") ;; *) printf '%s' "$a";; esac; }
link_router() { ipconfig getoption "$1" router 2>/dev/null; }
default_iface(){ route -n get default 2>/dev/null | awk '/interface:/{print $2}'; }
proxy_running(){ [ -f "$PROXY_PID" ] && kill -0 "$(cat "$PROXY_PID")" 2>/dev/null; }
phone_hits()  { [ -f "$PROXY_LOG" ] || { echo 0; return; }; grep -c "Connect (file descriptor [0-9]*): $PHONE_IP" "$PROXY_LOG"; true; }
service_for_dev() {
  networksetup -listnetworkserviceorder | awk -v dev="$1" '
    /^\([0-9*]+\) /{name=$0; sub(/^\([0-9*]+\) /,"",name)}
    /Device: /{ if ($0 ~ ("Device: " dev "\\)")) print name }'
}

# ---------- fixes ----------
ensure_wifi_first() {
  local wdev wsvc order args
  wdev=$(wifi_iface); [ -n "$wdev" ] || { fail "This Mac has no Wi-Fi interface."; return 1; }
  wsvc=$(service_for_dev "$wdev"); [ -n "$wsvc" ] || wsvc="Wi-Fi"
  order=$(networksetup -listnetworkserviceorder | sed -n 's/^([0-9*]*) //p')
  args=("$wsvc")
  while IFS= read -r s; do [ -n "$s" ] && [ "$s" != "$wsvc" ] && args+=("$s"); done <<< "$order"
  networksetup -ordernetworkservices "${args[@]}" >/dev/null 2>&1
}

need_tinyproxy() {
  command -v tinyproxy >/dev/null 2>&1 && return 0
  warn "tinyproxy (the small HTTP proxy this tool uses) is not installed."
  if command -v brew >/dev/null 2>&1; then
    yesno "Install it now with Homebrew?" || return 1
    brew install tinyproxy || return 1
    command -v tinyproxy >/dev/null 2>&1
  else
    fail "Homebrew is not installed. Install it from https://brew.sh, then run: brew install tinyproxy"
    return 1
  fi
}

link_up() {
  # Brings the iPhone USB link up. Sets IF, LINK_ADDR, PHONE_IP. Loops with hints until it works.
  local t hinted
  IF=""
  if ! phone_on_usb; then
    say "Waiting for the iPhone on USB"
    hint "Plug the phone into the Mac with a data cable (the one that came with the phone works)."
    hint "Unlock the phone. If it asks to Trust This Computer, tap Trust."
    t=0; while ! phone_on_usb; do sleep 1; dot; t=$((t+1)); [ $t -eq 30 ] && { echo; hint "Still nothing. Charge-only cables look identical but carry no data. Try another cable or port."; }; done; echo
  fi
  ok "iPhone detected on USB"

  IF=$(usb_iface)
  if ! iface_exists "$IF"; then
    say "Waiting for the hotspot link"
    hint "On the phone: Settings > Personal Hotspot > turn it on (Allow Others to Join)."
    hint "If it is already on: unplug the cable, wait 5 s, plug it back in."
    t=0; hinted=0
    while :; do IF=$(usb_iface); iface_exists "$IF" && break; sleep 1; dot; t=$((t+1))
      if [ $t -eq 30 ] && [ $hinted -eq 0 ]; then echo; hinted=1
        hint "Still no link. Toggle Personal Hotspot off and on while the phone stays plugged in."
        hint "If the hotspot toggle is greyed out, turn on Cellular Data first (Settings > Cellular)."
      fi
    done; echo
  fi
  ok "Hotspot link present ($IF)"

  if ! ifconfig "$IF" | grep -q "<UP,"; then
    say "The link needs to be switched on (macOS leaves it off). This needs your password once."
    sudo -p "Password: " ifconfig "$IF" up || { fail "Could not bring $IF up."; return 1; }
  fi

  LINK_ADDR=$(link_addr "$IF")
  if [ -z "$LINK_ADDR" ]; then
    say "Waiting for the phone to hand out an address"
    t=0; while [ -z "$LINK_ADDR" ]; do sleep 1; dot; LINK_ADDR=$(link_addr "$IF"); t=$((t+1))
      [ $t -eq 25 ] && { echo; hint "No address yet. Unplug and replug the phone, keeping the hotspot on."; }
      [ $t -eq 60 ] && { echo; hint "Toggle Personal Hotspot off and on."; }
    done; echo
  fi
  PHONE_IP=$(link_router "$IF"); [ -n "$PHONE_IP" ] || PHONE_IP="${LINK_ADDR%.*}.1"
  ok "Link up: Mac $LINK_ADDR, phone $PHONE_IP"

  if [ "$(default_iface)" = "$IF" ]; then
    warn "The Mac was about to use the phone's cellular data for itself. Fixing network order."
    ensure_wifi_first; sleep 2
    if [ "$(default_iface)" = "$IF" ]; then fail "The Mac's default route is still the phone. Is Wi-Fi connected?"; return 1; fi
  fi
  ok "Mac still uses Wi-Fi for its own internet ($(default_iface))"
}

# ---------- proxy ----------
write_proxy_conf() {
  cat > "$PROXY_CONF" <<CONF
Port $PROXY_PORT
Listen $LINK_ADDR
Timeout 600
Allow ${LINK_ADDR%.*}.0/28
MaxClients 300
LogLevel Connect
LogFile "$PROXY_LOG"
PidFile "$PROXY_PID"
CONF
}
start_proxy() {
  stop_proxy
  write_proxy_conf
  tinyproxy -c "$PROXY_CONF" || { fail "tinyproxy failed to start."; return 1; }
  sleep 1
  proxy_running || { fail "tinyproxy exited. Check $PROXY_LOG"; return 1; }
  curl -s -o /dev/null --max-time 10 --proxy "http://$LINK_ADDR:$PROXY_PORT" https://www.apple.com/ \
    && ok "Proxy running on $LINK_ADDR:$PROXY_PORT and reaching the internet" \
    || warn "Proxy is running but a test fetch failed. Is the Mac's Wi-Fi online?"
}
stop_proxy() { proxy_running && kill "$(cat "$PROXY_PID")" 2>/dev/null; rm -f "$PROXY_PID"; return 0; }

# ---------- profile ----------
make_profile() {
  local u1 u2; u1=$(uuidgen); u2=$(uuidgen)
  cat > "$PROFILE" <<XML
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadType</key><string>com.apple.cellular</string>
      <key>PayloadVersion</key><integer>1</integer>
      <key>PayloadIdentifier</key><string>local.rehtet.cellular</string>
      <key>PayloadUUID</key><string>$u1</string>
      <key>PayloadDisplayName</key><string>Cellular APN + USB proxy</string>
      <key>APNs</key>
      <array>
        <dict>
          <key>Name</key><string>$APN</string>
          <key>AuthenticationType</key><string>PAP</string>
          <key>ProxyServer</key><string>$LINK_ADDR</string>
          <key>ProxyPort</key><integer>$PROXY_PORT</integer>
          <key>AllowedProtocolMask</key><integer>3</integer>
        </dict>
      </array>
    </dict>
  </array>
  <key>PayloadDisplayName</key><string>rehtet (internet via Mac USB)</string>
  <key>PayloadDescription</key><string>Sends this phone's web traffic through the Mac it is plugged into. Remove this profile to go back to normal cellular data.</string>
  <key>PayloadIdentifier</key><string>local.rehtet</string>
  <key>PayloadRemovalDisallowed</key><false/>
  <key>PayloadType</key><string>Configuration</string>
  <key>PayloadUUID</key><string>$u2</string>
  <key>PayloadVersion</key><integer>1</integer>
</dict>
</plist>
XML
  plutil -lint "$PROFILE" >/dev/null || { fail "Generated profile is invalid."; return 1; }
}

start_serve() {
  stop_serve
  : > "$HITS"
  local len; len=$(stat -f %z "$PROFILE")
  (
    while :; do
      { printf 'HTTP/1.1 200 OK\r\nContent-Type: application/x-apple-aspen-config\r\nContent-Length: %s\r\nConnection: close\r\n\r\n' "$len"; cat "$PROFILE"; } \
        | nc -l "$LINK_ADDR" "$PROFILE_PORT" >> "$HITS" 2>/dev/null
      sleep 0.2
    done
  ) &
  echo $! > "$SERVE_PID"
}
stop_serve() {
  [ -f "$SERVE_PID" ] || return 0
  local p; p=$(cat "$SERVE_PID")
  pkill -P "$p" 2>/dev/null; kill "$p" 2>/dev/null; rm -f "$SERVE_PID"
}

install_profile_flow() {
  # Assumes link is up and proxy running. Serves the profile and walks the person through installing it.
  make_profile || return 1
  start_serve
  step "Install the profile on the phone"
  say "On the phone, open Safari and go to:"
  printf '\n    %shttp://%s:%s/rehtet.mobileconfig%s\n\n' "$B" "$LINK_ADDR" "$PROFILE_PORT" "$N"
  say "Safari will say the website is trying to download a configuration profile. Tap Allow."
  say "Waiting for the phone to fetch it"
  local t=0
  while ! grep -q "GET " "$HITS" 2>/dev/null; do
    sleep 1; dot; t=$((t+1))
    [ $t -eq 40 ] && { echo; hint "Nothing yet. Type the address exactly, including http:// and the port."; hint "If the page does not load at all, the hotspot link dropped: run 'rehtet status' in another terminal."; }
  done; echo
  ok "Phone downloaded the profile"
  stop_serve
  say
  say "Now install it:"
  say "  1. Open Settings. Near the top tap ${B}Profile Downloaded${N}."
  say "  2. Tap Install, enter your passcode, and accept the 'Not Signed' warning."
  say "     (It is unsigned because this Mac just generated it. Its full contents are in $PROFILE.)"
  say "  3. Tap Install again until it says Installed, then Done."
  pause
}

apply_profile_flow() {
  step "Apply it"
  say "iOS only picks up the new setting when the cellular connection restarts."
  say "On the phone: turn ${B}Airplane Mode on${N}, wait 10 seconds, turn it ${B}off${N}."
  say "Then turn ${B}Personal Hotspot back on${N} (Airplane Mode switches it off)."
  say "Watching the USB link"
  local t=0 dropped=0
  while [ $t -lt 90 ]; do
    if ! iface_exists "$IF" || [ -z "$(link_addr "$IF")" ]; then dropped=1; break; fi
    sleep 1; dot; t=$((t+1))
  done; echo
  if [ $dropped -eq 1 ]; then
    ok "Link dropped (cellular restarted). Waiting for it to come back."
    hint "If it does not come back: unplug and replug the phone with the hotspot on."
    sleep 3
  else
    warn "The link never dropped. If you did not do the Airplane Mode cycle yet, do it now."
  fi
  local old="$LINK_ADDR"
  link_up || return 1
  if [ "$LINK_ADDR" != "$old" ]; then
    warn "The Mac's address on the link changed ($old -> $LINK_ADDR) but the profile points at $old."
    say "Regenerating the profile for the new address."
    start_proxy && install_profile_flow && apply_profile_flow
    return
  fi
  proxy_running || start_proxy
}

verify_flow() {
  step "Verify"
  say "On the phone, open Safari and load any website, for example https://api.ipify.org"
  say "(that page prints the public IP it sees; through the Mac it should be the Mac's, not your carrier's)."
  say "Watching for the phone's traffic on the Mac"
  local base t=0 n
  base=$(phone_hits)
  while :; do
    n=$(phone_hits)
    [ "$n" -gt "$base" ] && break
    sleep 1; dot; t=$((t+1))
    [ $t -ge 75 ] && break
  done; echo
  if [ "$n" -gt "$base" ]; then
    ok "It works. $((n-base)) connections from the phone came through the Mac."
    return 0
  fi
  fail "No traffic from the phone reached the Mac."
  if yesno "Does the phone load websites right now (over cellular)?"; then
    say "Then the profile is installed but not in effect. Usual causes:"
    hint "The Airplane Mode cycle was skipped or too short. Do it again (on, wait 10 s, off, hotspot on)."
    hint "Settings > General > VPN & Device Management: the rehtet profile should be listed. If not, install it."
    hint "Your carrier locks APN settings (Jio does). Try a SIM from a carrier that does not, or use the wired fallback."
  else
    say "Then the phone is sending to the proxy but cannot reach it. Usual causes:"
    hint "Hotspot link down: run 'rehtet start' and it will bring it back up."
    hint "The Mac got a different address than the profile expects: 'rehtet profile' regenerates and reinstalls it."
  fi
  return 1
}

# ---------- commands ----------
carrier_pick() {
  step "Your carrier"
  say "The profile must carry your carrier's APN name (the same one it already uses)."
  say "Pick one, or choose custom if yours is not listed. ${D}Verify on your carrier's website if unsure.${N}"
  say "Two SIMs? Pick the carrier of the SIM used for data: Settings > Cellular > Cellular Data."
  cat <<LIST
   1) Airtel (India)        airtelgprs.com
   2) Vi / Vodafone (India) www
   3) BSNL (India)          bsnlnet
   4) Jio (India)           jionet      ${Y}(Jio locks APN settings; usually does not work)${N}
   5) T-Mobile (US)         fast.t-mobile.com
   6) Google Fi (US)        h2g2
   7) EE (UK)               everywhere
   8) O2 (UK)               mobile.o2.co.uk
   9) Three (UK)            three.co.uk
  10) Telstra (AU)          telstra.internet
  11) Custom
LIST
  local c
  while :; do
    c=$(ask "Choice [1-11]:")
    case "$c" in
      1) APN=airtelgprs.com;; 2) APN=www;; 3) APN=bsnlnet;; 4) APN=jionet;;
      5) APN=fast.t-mobile.com;; 6) APN=h2g2;; 7) APN=everywhere;; 8) APN=mobile.o2.co.uk;;
      9) APN=three.co.uk;; 10) APN=telstra.internet;;
      11) APN=$(ask "APN name:");;
      *) continue;;
    esac
    [ -n "$APN" ] && break
  done
  ok "APN: $APN"
  say "${D}Tip: if Settings > Cellular > Cellular Data Network exists on your phone, the APN shown there is the right one,${N}"
  say "${D}and you could type the proxy in there directly. rehtet handles the carriers that hide that screen.${N}"
}

cmd_setup() {
  load_cfg
  printf '%srehtet %s%s - share this Mac'"'"'s Wi-Fi with your iPhone over a USB-C cable\n' "$B" "$VERSION" "$N"
  say
  say "What you need: a Mac on Wi-Fi, an iPhone with a SIM that has cellular data,"
  say "and a USB-C data cable. Takes about 3 minutes. Each step waits until it has"
  say "actually worked before moving on."
  step "Step 1 of 6: checks"
  [ "$(uname)" = Darwin ] || { fail "macOS only."; exit 1; }
  need_tinyproxy || exit 1
  ok "tinyproxy installed"
  local wdev; wdev=$(wifi_iface)
  if [ "$(default_iface)" != "$wdev" ]; then
    warn "The Mac's internet is not going over Wi-Fi right now (default route: $(default_iface))."
    say "That is fine if it is wired Ethernet. It is not fine if it is the phone."
  else ok "Mac is online over Wi-Fi ($wdev)"; fi
  ensure_wifi_first && ok "Network order set so the Mac never uses the phone's data for itself"

  step "Step 2 of 6: carrier"; carrier_pick
  save_cfg

  step "Step 3 of 6: connect the phone"
  say "Phone: Settings > Cellular > Cellular Data on. Settings > Personal Hotspot on."
  say "Then plug it into the Mac."
  link_up || exit 1
  save_cfg
  start_proxy || exit 1

  say; say "Step 4 of 6"; install_profile_flow || exit 1
  say; say "Step 5 of 6"; apply_profile_flow || exit 1
  save_cfg
  say; say "Step 6 of 6"
  if verify_flow; then
    step "Done"
    say "Your phone's web traffic now goes through this Mac's Wi-Fi over the cable."
    say
    say "Day to day:"
    say "  ${B}rehtet start${N}   after plugging in (brings the link up, starts the proxy)"
    say "  ${B}rehtet stop${N}    when you unplug"
    say "  ${B}rehtet status${N}  to see what is going on"
    say
    warn "While the profile is installed and the Mac is not attached, the phone has no web access."
    say "Remove it under Settings > General > VPN & Device Management to get normal data back,"
    say "and run ${B}rehtet profile${N} to reinstall it later."
    say "Only HTTP/HTTPS goes through the Mac; push notifications and iMessage still use cellular."
  else
    say; say "Fix the cause above, then run ${B}rehtet start${N} (link + proxy) or ${B}rehtet setup${N} again."
    exit 1
  fi
}

cmd_start() {
  load_cfg
  [ -n "$APN" ] || { fail "Not set up yet. Run: rehtet setup"; exit 1; }
  need_tinyproxy || exit 1
  local old="$LINK_ADDR"
  link_up || exit 1
  if [ -n "$old" ] && [ "$LINK_ADDR" != "$old" ]; then
    warn "The Mac's address on the link is $LINK_ADDR but the phone's profile points at $old."
    say "Run ${B}rehtet profile${N} to regenerate and reinstall the profile."
    exit 1
  fi
  save_cfg
  start_proxy || exit 1
  say "Open a website on the phone to confirm"
  local base t=0 n; base=$(phone_hits)
  while :; do n=$(phone_hits); [ "$n" -gt "$base" ] && break; sleep 1; dot; t=$((t+1)); [ $t -ge 45 ] && break; done; echo
  if [ "$n" -gt "$base" ]; then ok "Phone traffic is flowing through the Mac."
  else warn "No traffic seen yet. If the phone loads pages but slowly or not at all, run: rehtet status"; fi
}

cmd_stop() { load_cfg; stop_proxy; stop_serve; ok "Proxy stopped. Remove the profile on the phone if you are leaving the Mac behind."; }

cmd_status() {
  load_cfg
  local IF; IF=$(usb_iface)
  say "${B}rehtet status${N}"
  phone_on_usb && ok "iPhone on USB" || fail "No iPhone on USB"
  if iface_exists "$IF"; then
    local a; a=$(link_addr "$IF")
    if [ -n "$a" ]; then ok "Hotspot link $IF up: Mac $a, phone $(link_router "$IF")"; else fail "Hotspot link $IF present but no address (hotspot off? run: rehtet start)"; fi
    [ -n "$LINK_ADDR" ] && [ -n "$a" ] && [ "$a" != "$LINK_ADDR" ] && warn "Profile expects $LINK_ADDR, link is $a (run: rehtet profile)"
  else fail "No hotspot link (Personal Hotspot off or phone not offering it; replug)"; fi
  proxy_running && ok "Proxy running on ${LINK_ADDR:-?}:$PROXY_PORT ($(phone_hits) connections from the phone so far)" || fail "Proxy not running"
  say "  Mac default route: $(default_iface) $( [ "$(default_iface)" = "$(wifi_iface)" ] && echo '(Wi-Fi)' || echo '(not Wi-Fi!)')"
  [ -n "$APN" ] && say "  APN: $APN   profile: $PROFILE"
}

cmd_profile() {
  load_cfg
  [ -n "$APN" ] || { fail "Not set up yet. Run: rehtet setup"; exit 1; }
  need_tinyproxy || exit 1
  link_up || exit 1; save_cfg
  start_proxy || exit 1
  say; say "If an older rehtet profile is on the phone, remove it first:"
  say "Settings > General > VPN & Device Management > rehtet > Remove Profile."
  install_profile_flow && apply_profile_flow && save_cfg && verify_flow
}

cmd_uninstall() {
  load_cfg; stop_proxy; stop_serve
  rm -rf "$CFG_DIR"
  ok "Removed $CFG_DIR and stopped the proxy."
  say "On the phone: Settings > General > VPN & Device Management > rehtet > Remove Profile."
  say "Then delete this script (and 'brew uninstall tinyproxy' if you no longer need it)."
}

cmd_help() {
  cat <<H
${B}rehtet $VERSION${N} - share your Mac's Wi-Fi with an iPhone over a USB-C cable

  rehtet setup      guided first-time setup (about 3 minutes)
  rehtet start      after plugging the phone in: bring the link up, start the proxy
  rehtet stop       stop the proxy
  rehtet status     show link, proxy, and traffic state
  rehtet profile    regenerate the phone profile and walk through reinstalling it
  rehtet uninstall  remove config and stop everything

How it works: the phone's Personal Hotspot over USB gives the Mac and phone a
private link. A tiny HTTP proxy on the Mac listens on it, and a cellular APN
profile on the phone points at that proxy, so all web traffic goes down the
cable and out the Mac's Wi-Fi instead of over cellular.

Limits: HTTP/HTTPS only (Safari and nearly all apps). Push notifications and
iMessage still use cellular. With the profile installed and the Mac absent, the
phone has no web access until the profile is removed. Carriers that lock APN
settings (Jio, Verizon, AT&T) do not work.
H
}

[ "${REHTET_LIB:-}" = 1 ] && return 0 2>/dev/null
case "${1:-help}" in
  setup) cmd_setup;; start) cmd_start;; stop) cmd_stop;; status) cmd_status;;
  profile) cmd_profile;; uninstall) cmd_uninstall;; -v|--version) echo "$VERSION";;
  help|-h|--help) cmd_help;; *) fail "Unknown command: $1"; cmd_help; exit 1;;
esac
